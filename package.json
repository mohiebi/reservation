{
  "name": "reservation",
  "version": "1.0.0",
  "description": "سیستم نوبت‌دهی آنلاین (رزرو) با تقویم شمسی، پنل مدیریت، پیامک و پرداخت آنلاین",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jalaali-js": "^2.0.1"
  }
}
