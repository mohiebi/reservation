# نمونهٔ تنظیمات محیطی؛ آن را به .env کپی کنید.
PORT=3000

# آدرس عمومی سایت (بدون / در انتها). برای بازگشت از درگاه پرداخت و لینک داخل پیامک لازم است.
BASE_URL=http://localhost:3000

# پشت HTTPS مقدار true بگذارید
COOKIE_SECURE=false

# پشت Nginx / Cloudflare تعداد پروکسی‌ها (معمولاً 1)
# TRUST_PROXY=1

# مسیر فایل دیتابیس
# DB_PATH=./data/reservation.db
